{
  "name": "trainerfit2",
  "type": "module",
  "scripts": {
    "dev": "npm run services:up && npm run services:wait:database && next dev",
    "test": "npm run services:up && concurrently -n next,jest --hide next --kill-others -k --success command-jest \"next dev\" \"NODE_OPTIONS=--experimental-vm-modules jest --runInBand --verbose\"",
    "posttest": "npm run services:stop",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watchAll --runInBand --verbose ",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:down": "docker compose -f infra/compose.yaml down",
    "services:wait:database": "node infra/scripts/wait-for-postgres.ts",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:eslint:check": "eslint .",
    "prepare": "husky",
    "commit": "cz"
  },
  "dependencies": {
    "async-retry": "^1.3.3",
    "dotenv": "^17.4.2",
    "hono": "^4.13.0",
    "next": "^16.2.10",
    "next-connect": "^1.0.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.22.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@jest/globals": "^30.4.1",
    "@types/async-retry": "^1.4.9",
    "@types/jest": "^30.0.0",
    "@types/node": "^26",
    "@types/pg": "^8.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "commitizen": "^4.3.2",
    "concurrently": "^10.0.4",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9",
    "eslint-config-next": "^16.2.10",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "prettier": "3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "^5"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
